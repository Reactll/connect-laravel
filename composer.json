{
    "name": "reactll/connect",
    "description": "Reactll Connect for Laravel: visits, clicks, form leads, sales and site health for your Reactll dashboard.",
    "keywords": ["laravel", "analytics", "leads", "orders", "reactll"],
    "homepage": "https://reactll.com",
    "license": "MIT",
    "authors": [
        {"name": "Reactor Technology", "homepage": "https://reactll.com"}
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Reactll\\Connect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reactll\\Connect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": ["Reactll\\Connect\\ConnectServiceProvider"],
            "aliases": {"ReactllConnect": "Reactll\\Connect\\Facades\\Connect"}
        }
    },
    "minimum-stability": "stable"
}
